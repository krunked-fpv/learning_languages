{
  "name": "wanderling",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Wanderling: The Grand Atlas of Living Tongues — 16-language interactive learning adventure & offline PWA.",
  "scripts": {
    "generate:icons": "node scripts/generate-pwa-icons.mjs",
    "prebuild": "npm run generate:icons",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "verify:artifacts": "node scripts/verify-build-artifacts.mjs",
    "serve:subpath": "node scripts/serve-subpath.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
